{
  "name": "volley",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/app",
    "build": "npm run build --workspace=packages/design-system && npm run build --workspace=packages/app",
    "storybook": "npm run storybook --workspace=packages/design-system",
    "test": "npm run test:run --workspaces",
    "type-check": "npm run type-check --workspaces",
    "vendor:lockin": "node scripts/vendor-lockin.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@lockin/icons": "file:vendor/lockin-icons-0.1.0.tgz",
    "@lockin/react": "file:vendor/lockin-react-0.1.0.tgz",
    "@lockin/tokens": "file:vendor/lockin-tokens-0.1.0.tgz"
  }
}
