generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TournamentStatus {
  DRAFT
  REGISTRATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventStatus {
  DRAFT
  REGISTRATION
  SEEDING
  IN_PROGRESS
  COMPLETED
}

enum TeamStatus {
  REGISTERED
  WAITLISTED
  WITHDRAWN
  CHECKED_IN
}

enum TeamMemberRole {
  CAPTAIN
  PLAYER
}

enum StageType {
  POOL_PLAY
  ROUND_ROBIN
  SINGLE_ELIM
  DOUBLE_ELIM
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

// User, Session, Account and Verification are the tables Better Auth reads and
// writes. Field names follow its core schema; add app fields to User freely.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  // Better Auth requires a name. It is always "firstName lastName", set by a hook in
  // lib/auth.ts, so use firstName and lastName for anything that needs the parts.
  name          String
  firstName     String
  lastName      String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  ownedTournaments Tournament[]
  ownedLocations   Location[]
  teamMemberships  TeamMember[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per sign-in method. Email/password stores the hash in `password`;
// SSO providers added later store tokens here instead.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Tournament & Location
// ---------------------------------------------------------------------------

model Tournament {
  id          String           @id @default(cuid())
  name        String
  description String?
  status      TournamentStatus @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  // [{ place: 1, amount: 500, label: "1st Place" }]
  payouts     Json?
  // [{ platform: "YouTube", url: "https://..." }]
  liveStreams  Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  events Event[]
}

// A reusable venue. It may have no fixed courts (a park or beach where the
// organizer brings their own nets); those are created per event on Court.eventId.
model Location {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  name      String
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courts      Court[]
  tournaments Tournament[]

  @@index([ownerId])
}

// Belongs to exactly one of: a Location (fixed court, reusable across events) or
// an Event (temporary net set up for that event only). The "exactly one" rule is
// a CHECK constraint in the migration because Prisma can't express it.
model Court {
  id         String    @id @default(cuid())
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  eventId    String?
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // "Court 1", "Court A", "Sand Court 3"
  name       String
  // "hardwood", "sand", "grass" — extensible for future sports
  surface    String?
  createdAt  DateTime  @default(now())

  eventCourts EventCourt[]
  matches     Match[]

  @@index([locationId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Events
// ---------------------------------------------------------------------------

model Event {
  id           String      @id @default(cuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  // players per team: 2=doubles, 4=quads, 6=sixes
  teamSize     Int
  entryCap     Int?
  status       EventStatus @default(DRAFT)
  // match format
  bestOf              Int  @default(1)
  pointsToWin         Int  @default(25)
  // if null, same as pointsToWin
  pointsToWinLastGame Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Courts in use at this event (fixed or temporary)
  courts        EventCourt[]
  // Temporary courts that exist only for this event
  ownCourts     Court[]
  teams         Team[]
  teamMembers   TeamMember[]
  stages        Stage[]
  scheduleItems EventScheduleItem[]
}

// Which courts are allocated to an event
model EventCourt {
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  courtId String
  court   Court  @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@id([eventId, courtId])
}

// ---------------------------------------------------------------------------
// Stages (ordered format steps within an event)
// ---------------------------------------------------------------------------

model Stage {
  id      String    @id @default(cuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // 1 = first stage played, 2 = second, etc.
  order   Int
  name    String
  type    StageType
  // how many teams advance to the next stage (null = final stage)
  advancementCount Int?
  // complex seeding rules expressed as JSON when advancementCount isn't enough
  advancementRule  Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pools   Pool[]
  matches Match[]

  @@unique([eventId, order])
}

// ---------------------------------------------------------------------------
// Pools (within a POOL_PLAY or ROUND_ROBIN stage)
// ---------------------------------------------------------------------------

model Pool {
  id      String @id @default(cuid())
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  // "Pool A", "Pool B"
  name    String

  teams   PoolTeam[]
  matches Match[]
}

model PoolTeam {
  poolId String
  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // seeding order into this pool
  seed   Int?

  @@id([poolId, teamId])
}

// ---------------------------------------------------------------------------
// Teams (event-scoped)
// ---------------------------------------------------------------------------

model Team {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  // True while `name` is generated from the members' last names ("Kim/Lopez"), so it
  // follows membership changes. False once someone types a name, and for teams an
  // organizer created.
  usesDefaultName Boolean @default(false)
  // overall event seed; updated after each stage
  seed      Int?
  status    TeamStatus @default(REGISTERED)
  // The secret in the link a captain shares so teammates can join. Null for teams an
  // organizer created, and never returned by the public queries.
  inviteCode String?   @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  members TeamMember[]
  pools   PoolTeam[]

  matchesAsTeam1 Match[] @relation("MatchTeam1")
  matchesAsTeam2 Match[] @relation("MatchTeam2")
  wonMatches     Match[] @relation("MatchWinner")
}

model TeamMember {
  id     String         @id @default(cuid())
  teamId String
  team   Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  // The team's event, repeated here so the database itself can insist on one team per
  // person per event (a unique index can't reach across to Team.eventId). It never
  // differs from the team's own eventId.
  eventId String
  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId String
  user   User           @relation(fields: [userId], references: [id])
  role   TeamMemberRole @default(PLAYER)

  @@unique([teamId, userId])
  @@unique([eventId, userId])
}

// ---------------------------------------------------------------------------
// Matches & Games
// ---------------------------------------------------------------------------

model Match {
  id      String @id @default(cuid())
  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  // null for bracket matches
  poolId  String?
  pool    Pool?  @relation(fields: [poolId], references: [id])

  // Bracket positioning — null for pool play
  // e.g. "Winners Final", "Losers Round 2", "Semifinal"
  bracketRound    String?
  // slot index within that round (used to wire up next-match progression)
  bracketPosition Int?

  // null = TBD (seeded in after earlier matches complete)
  team1Id String?
  team1   Team?  @relation("MatchTeam1", fields: [team1Id], references: [id])
  team2Id String?
  team2   Team?  @relation("MatchTeam2", fields: [team2Id], references: [id])

  courtId String?
  court   Court? @relation(fields: [courtId], references: [id])

  status          MatchStatus @default(SCHEDULED)
  scheduledTime   DateTime?
  actualStartTime DateTime?

  winnerId String?
  winner   Team?  @relation("MatchWinner", fields: [winnerId], references: [id])

  // The id the Bracket component uses for this match ("r1-m1", "lb-r2-m1", "gf-m1").
  // Null for pool play.
  bracketKey String?

  // Bracket progression: where winner and loser go next, and which side of that
  // match they fill (1 = team1, 2 = team2). The slot is set whenever the match is.
  nextWinnerMatchId String?
  nextWinnerSlot    Int?
  nextLoserMatchId  String?
  nextLoserSlot     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games Game[]

  @@unique([stageId, bracketKey])
}

// Individual games within a match (for best-of-3/5 formats)
model Game {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber Int
  team1Score Int      @default(0)
  team2Score Int      @default(0)
  // references Team.id — not a FK to avoid circular complexity
  winnerId   String?
  completedAt DateTime?

  @@unique([matchId, gameNumber])
}

// ---------------------------------------------------------------------------
// Schedule
// ---------------------------------------------------------------------------

model EventScheduleItem {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // "Pool Play Begins", "Bracket Starts", "Awards Ceremony"
  label         String
  scheduledTime DateTime
  // updated on the fly when the tournament runs ahead/behind
  actualTime    DateTime?
  // minutes allocated per match slot during this window
  matchDurationMinutes Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
